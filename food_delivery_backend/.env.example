# Backend service configuration
APP_NAME="Gourmet Delivery Platform API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"

# CORS (React dev server)
CORS_ORIGINS="http://localhost:3000"

# JWT auth (set to a strong random value in production)
JWT_SECRET="change-me"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="60"

# PostgreSQL (provided by the database container)
POSTGRES_URL=""
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""
POSTGRES_PORT=""

# Optional: if you want to provide a full SQLAlchemy URL directly (overrides POSTGRES_*)
DATABASE_URL=""

# Payment stub/mock
PAYMENTS_PROVIDER="mock"
PAYMENTS_WEBHOOK_SECRET=""
